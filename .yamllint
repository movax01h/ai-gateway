extends: default

# Skip everything git ignores (virtualenvs, caches, test output, agent worktrees,
# generated agent configs). CI never sees those files. .yamllintignore holds the
# tracked paths we also skip.
ignore-from-file:
  - .gitignore
  - .yamllintignore

rules:
  # Prompt definitions and CI script blocks are long by nature.
  line-length: disable
  # The repo has never used `---` document markers.
  document-start: disable
