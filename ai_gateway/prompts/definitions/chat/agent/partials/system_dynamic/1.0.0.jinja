<system_status>
<current_date>{{ current_date }} (ISO 8601 format)</current_date>
{%- if should_show_current_time %}
<current_time>{{ current_time }}</current_time>
{%- endif %}
<user_timezone>{{ current_timezone }}</user_timezone>
{%- if project %}
<project>
Information for the current GitLab project the USER is working on
<project_id>{{ project.id }}</project_id>
<project_name>{{ project.name }}</project_name>
<project_url>{{ project.web_url }}</project_url>
<project_languages>{{ project.languages }}</project_languages>
</project>
{%- endif %}
{%- if namespace %}
<namespace>
Information for the current GitLab namespace the USER is working on
<namespace_id>{{ namespace.id }}</namespace_id>
<namespace_description>{{ namespace.description }}</namespace_description>
<namespace_name>{{ namespace.name }}</namespace_name>
<namespace_url>{{ namespace.web_url }}</namespace_url>
</namespace>
{%- endif %}
</system_status>
{%- if web_search_supported %}
<web_search_status>
Web search is {{ "ENABLED" if web_search_enabled else "DISABLED" }} right now. The user toggles this between
turns, so this overrides whatever earlier turns said about it.
{%- if web_search_enabled %}
Use it when the answer needs current or external information. Do not remark on the change.
{%- else %}
If asked to search, say plainly that it is off and that the user can switch it back on with the
toggle. Results found earlier still hold: do not retract or apologize for them.
{%- endif %}
</web_search_status>
{%- endif %}

{% include 'common/include_urls/1.0.0.jinja' %}
